# === LLM (OpenAI-совместимые провайдеры; значения — ваши) ===
# Внешний DeepSeek (SMB-MVP)
DEEPSEEK_API_BASE=https://api.deepseek.com
DEEPSEEK_API_KEY=
LLM_MODEL_MAIN=deepseek-flash
# Критик — другое семейство, чем разработчик (пример: другой провайдер/модель)
LLM_MODEL_JUDGE=deepseek-v4-pro

# Локальный OpenAI-совместимый (альтернатива / enterprise-режим)
LOCAL_LLM_API_BASE=http://vllm:8000/v1
LOCAL_LLM_API_KEY=

# Активный провайдер по умолчанию: deepseek | local
LLM_PROVIDER=deepseek
# Разрешить настройку LLM из кабинета (ADR-033): провайдер/адрес/модели/ключ правятся на экране «Настройки».
# Выкл. (по умолчанию) — экран только показывает конфиг. Включать на одно-арендной коробке в контуре, НЕ на общем облаке.
# Изменения применяются после перезапуска харнесса.
LLM_SETTINGS_EDITABLE=false

# === DLP (egress во внешний LLM) ===
DLP_ENABLED=true

# === Письма с кодом входа по почте (R-39) ===
# Пусто — писем нет, код выдаёт и передаёт куратор. Порт 587 + starttls или 465 + ssl.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# === Эксплуатация: бэкап и оповещения (deploy/ops, T-72) ===
# Копия дампа на другой сервер по ssh-ключу; пусто — бэкап только на этом сервере.
BACKUP_REMOTE=
# Бот оповещений администратору (не бот кабинета); пусто — оповещения в stderr для cron.
ALERT_BOT_TOKEN=
ALERT_CHAT_ID=

# === Канал (C-1) ===
TELEGRAM_BOT_TOKEN=
# Вход в веб-кабинет (T-31, ADR-025): BotFather → бот → Login Widget → Allowed URLs: <WEB_BASE_URL>/auth/callback;
# там же Client ID и Client Secret. Публичный адрес кабинета — https в бою (cookie Secure).
TELEGRAM_OIDC_CLIENT_ID=
TELEGRAM_OIDC_CLIENT_SECRET=
WEB_BASE_URL=http://localhost:8081
TELEGRAM_BOT_USERNAME=metabrain_bot
HARNESS_API_TOKEN=replace-with-a-random-service-token

# === Подписи (ADR-008); local compose читает env:ИМЯ_ПЕРЕМЕННОЙ ===
# Заполняйте секреты локально; compose передаёт каждый только нужным сервисам.
# В production используйте внешний secret store, не .env.
VALIDATOR_SIGNING_KEY=
# Набор профилей валидатора (ADR-016): demo-v1 | mvp-v1
VALIDATOR_PROFILE_SET=demo-v1
# Корневой ключ удостоверяет отдельный ключ подписи каждого харнесса (C-1/C-5).
CONSENT_SIGNING_KEY=
CONSENT_TOKEN_TTL_SECONDS=900

# === Демо-ландшафт (specs/60-demo-landscape.md) ===
# JSON {token: {user, systems[]}}; user = manager-a | manager-b, systems ⊆ [crm, stock, pricing].
# Токен менеджер вводит в веб-кабинете при подключении системы; в харнесс он попадает только через secret store.
DEMO_LANDSCAPE_TOKENS=
# Те же токены — харнессу, чтобы подключать системы с secret_ref env:DEMO_LANDSCAPE_TOKEN_A / _B (T-19).
DEMO_LANDSCAPE_TOKEN_A=
DEMO_LANDSCAPE_TOKEN_B=

# === Хранилища ===
POSTGRES_PASSWORD=changeme
# Роли сервисов (ADR-019) создаются при инициализации пустого тома postgres.
# Поменяли пароль или добавили роль на существующем томе — пересоздайте том: docker compose down -v
HARNESS_DB_PASSWORD=changeme-harness
METABRAIN_DB_PASSWORD=changeme-metabrain
# Ключ хранилища доступов, введённых в кабинете (ADR-028): 32 случайных байта в base64.
# Сгенерировать: python -c "import base64, os; print(base64.b64encode(os.urandom(32)).decode())"
# Без ключа ввод доступа в кабинете отвечает 503; потеря ключа = повторный ввод доступов.
SECRET_STORE_KEY=
# Публичный корневой ключ согласий (raw Ed25519, base64): сервисы проверяют сертификаты ключей харнессов.
# Получить из CONSENT_SIGNING_KEY: см. src/metabrain/README.md
CONSENT_PUBLIC_KEY=
# MCP-клиенты мета-мозга (ADR-022): JSON {token: {client_id, company_id, harness_id?}}, токен ≥ 24 символов.
# Scope клиента — policy.mcp_scopes[client_id]; в демо-политике есть client_id "demo-ide".
MCP_CLIENTS=
# Разрешённые Origin для браузерных MCP-клиентов, через запятую; пусто — запросы с Origin отклоняются.
MCP_ALLOWED_ORIGINS=
QDRANT_URL=http://qdrant:6333
NATS_URL=nats://nats:4222

# === VPS / сервис ===
APP_BASE_URL=http://localhost:8080
LOG_LEVEL=info
